# Deixe vazio para abrir o laboratorio em modo demonstracao.
TIKTOK_USERNAME=
# Opcional: sua chave EulerStream, caso use limites maiores.
TIKTOK_SIGN_API_KEY=
# Servidor fica restrito ao seu PC por padrao.
HOST=127.0.0.1
PORT=8787

# API de decisões da Jev (necessárias para o piloto TypeSafe).
TYPESAFE_API_KEY=
JEV_CONTROL_TOKEN=
JEV_MODEL=jev-latest

# Pasta do Obsidian no servidor local. A nuvem precisa de disco persistente
# para sobreviver a deploys; use sincronização do navegador como cópia local.
# JEV_BRAIN_PATH=C:\Users\gabriel\Desktop\Cerebro do Jev

# Narração ElevenLabs opcional. Sem estas variáveis, usa voz do navegador.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
